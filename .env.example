# Copy this file to .env
# Gemini: get a key from Google AI Studio.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional. Default is demo mode.
# Set to true only after configuring Gmail OAuth.
SEND_EMAILS=true

# AI model. If unavailable, the app automatically falls back to demo responses.
GEMINI_MODEL=gemini-3.8-flash