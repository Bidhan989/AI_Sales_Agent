# Copy to .env  (PowerShell: Copy-Item .env.example .env)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Leave blank to use the default (gemini-2.5-flash)
GEMINI_MODEL=
SENDER_NAME=Bidhan

# Gmail: keep false until credentials.json is set up
SEND_EMAILS=false
# SAFETY: when set, EVERY email goes here instead of the lead's address
TEST_RECIPIENT=bidhankc989@gmail.com

# Optional: n8n webhook URL to alert when a lead becomes Interested
N8N_WEBHOOK_URL=
