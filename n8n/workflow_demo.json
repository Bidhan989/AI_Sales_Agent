{
  "name": "ScaleBuild AI - Outbound Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "name": "Every day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/pipeline/run",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Run pipeline (new leads)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/followups/run",
        "options": {
          "timeout": 300000
        }
      },
      "name": "Send due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hot-lead",
        "options": {}
      },
      "name": "Hot lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "webhookId": "scalebuild-hot-lead"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "alert",
              "type": "string",
              "value": "=HOT LEAD: {{ $json.body.contact }} at {{ $json.body.company }} replied: {{ $json.body.reply }} -> {{ $json.body.action }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Format alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        240
      ]
    }
  ],
  "connections": {
    "Every day": {
      "main": [
        [
          {
            "node": "Run pipeline (new leads)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run pipeline (new leads)": {
      "main": [
        [
          {
            "node": "Send due follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hot lead webhook": {
      "main": [
        [
          {
            "node": "Format alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
